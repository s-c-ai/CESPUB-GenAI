from pathlib import Path
import pandas as pd

pasta = Path("C:/Users/normu/Downloads/Telegram Desktop")

arquivo_original = pasta / "Cópia de Estudo de Mercado V.05.03.2025 (cnpj) - Copia.xlsx"
arquivo_classificada = pasta / "resultado_gemini_tabela_completa.xlsx"
arquivo_saida = pasta / "dados_completos_final.xlsx"  

original = pd.read_excel(arquivo_original)
classificada = pd.read_excel(arquivo_classificada)

assert len(original) == len(classificada)

original["valor_total"] = (
    original["valor_total"]
    .astype(str)
    .str.replace("R$", "", regex=False)
    .str.replace(".", "", regex=False)
    .str.replace(",", ".", regex=False)
    .astype(float)
)

original["valor_total"] = original["valor_total"].apply(
    lambda x: f"R$ {x:,.2f}".replace(",", "v").replace(".", ",").replace("v", ".")
)

dados_completos = pd.concat(
    [original, classificada.drop(columns=["objeto", "descricao", "descricao_comp"])],
    axis=1
)

try:
    dados_completos.to_excel(arquivo_saida, index=False)
    print(f"Arquivo salvo com sucesso em:\n{arquivo_saida.resolve()}")
except Exception as e:
    print(f"Erro ao salvar o arquivo: {e}")
